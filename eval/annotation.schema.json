{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deal-ops/deal-ops-inbox/eval/annotation.schema.json",
  "title": "Deal Ops Inbox evaluation annotation",
  "description": "Version 2 (PRD v0.5). Every top-level field is required. Category-dependent completeness of `fields` is checked by eval/validate (E2). See eval/SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "mailbox",
    "mailbox_strips_auth_results",
    "received_at",
    "prior_messages",
    "description",
    "classes",
    "expected_risk",
    "malicious",
    "malicious_type",
    "twin_of",
    "signals",
    "fields",
    "rule_output",
    "links",
    "may_disclose_record",
    "draft_template",
    "notes"
  ],
  "$defs": {
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "classId": {
      "enum": [
        "payment_query",
        "payment_evidence",
        "unreferenced_payment",
        "kyc_documents",
        "withdrawal",
        "commitment_change",
        "fee_or_terms_change",
        "closing_confirmation",
        "legal_documents",
        "bank_details",
        "identity_change",
        "tax_certificates",
        "exit_distribution",
        "bank_letter_request",
        "account_access",
        "complaint",
        "other_known",
        "unclassified"
      ]
    },
    "templateId": {
      "enum": [
        "safe_ack",
        "payment_received",
        "payment_wait",
        "payment_need_evidence",
        "payment_need_reference",
        "unreferenced_ack",
        "kyc_received",
        "withdrawal_ack",
        "commitment_change_ack",
        "closing_ack",
        "legal_ack",
        "tax_cert_info",
        "exit_info",
        "bank_letter_info",
        "account_access_info",
        "complaint_ack"
      ]
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minor",
        "currency"
      ],
      "properties": {
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "linkTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_id",
        "investor_id",
        "deal"
      ],
      "properties": {
        "contact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "investor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "deal": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E[0-9]{4}$"
    },
    "family": {
      "type": "string",
      "pattern": "^F[0-9]{3,}$"
    },
    "mailbox": {
      "type": "string"
    },
    "mailbox_strips_auth_results": {
      "type": "boolean"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "prior_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "message_id",
          "sans_msgid_sha256"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "message_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sans_msgid_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/classId"
      }
    },
    "expected_risk": {
      "$ref": "#/$defs/risk"
    },
    "malicious": {
      "type": "boolean"
    },
    "malicious_type": {
      "enum": [
        null,
        "bank_change",
        "lookalike",
        "prompt_injection",
        "forged_evidence",
        "pressure"
      ]
    },
    "twin_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^E[0-9]{4}$"
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_fail",
        "untrusted_auth_header",
        "display_name_mismatch",
        "lookalike_domain",
        "reply_to_mismatch",
        "first_time_sender",
        "hidden_text",
        "injection_markers",
        "message_id_collision"
