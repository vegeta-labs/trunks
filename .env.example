# docker compose variables (docs/en/quickstart.md, "Compose variables"). Copy to .env and edit. No secrets here:
# secrets are files in TRUNKS_SECRETS_DIR (docker run … trunks:local init-secrets /out).
TRUNKS_CONFIG_DIR=./config/default
TRUNKS_SECRETS_DIR=./secrets
TRUNKS_PORT=8080
# the bundled HTTPS proxy (docker compose --profile proxy up -d)
# TRUNKS_DOMAIN=inbox.capital.example
# TRUST_PROXY=172.30.99.10
# TRUNKS_EDGE_SUBNET=172.30.99.0/24
# TRUNKS_PROXY_IP=172.30.99.10
