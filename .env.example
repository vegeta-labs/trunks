# docker compose variables (docs/en/quickstart.md, "Compose variables"). Copy to .env and edit. No secrets here:
# secrets are files in DOI_SECRETS_DIR (docker run … deal-ops-inbox:local init-secrets /out).
DOI_CONFIG_DIR=./config/default
DOI_SECRETS_DIR=./secrets
DOI_PORT=8080
# the bundled HTTPS proxy (docker compose --profile proxy up -d)
# DOI_DOMAIN=inbox.capital.example
# TRUST_PROXY=172.30.99.10
# DOI_EDGE_SUBNET=172.30.99.0/24
# DOI_PROXY_IP=172.30.99.10
