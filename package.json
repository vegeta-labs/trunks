{
  "name": "trunks",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src scripts parser e2e e2e-demo deploy eval/*.ts",
    "test": "vitest run",
    "oracle:selfcheck": "python3 eval/oracle/selfcheck.py",
    "coverage:check": "vitest run --reporter=default --reporter=json --outputFile=test-report.json && playwright test && node scripts/check-coverage.mjs test-report.json e2e-report.json",
    "check:no-send": "node --experimental-strip-types --no-warnings scripts/check-no-send.ts",
    "check:licences": "node scripts/check-licences.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:old-names": "node --experimental-strip-types --no-warnings scripts/check-old-names.ts",
    "eval": "node --experimental-strip-types --no-warnings eval/run.ts eval/dev",
    "eval:record": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings eval/run.ts eval/dev --record",
    "mutation": "node scripts/mutation-check.mjs",
    "build": "vite build --config vite.config.ts",
    "e2e": "playwright test",
    "demo:snapshot": "node --experimental-strip-types --no-warnings scripts/demo-snapshot.ts",
    "check:seccomp": "node scripts/gen-parser-seccomp.mjs --check",
    "test:compose": "vitest run --config vitest.compose.config.ts --reporter=default --reporter=json --outputFile=compose-report.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jose": "^6.2.14",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "argon2": "^0.45.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.10.0",
    "libmime": "^5.6.3",
    "libqp": "^3.0.1",
    "openid-client": "^6.8.8",
    "papaparse": "^5.7.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
