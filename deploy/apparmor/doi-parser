# AppArmor profile for the Deal Ops Inbox parser container (tech design T7, v0.7.11).
# Docker's docker-default rules, except that bubblewrap may build each task's sandbox: mount (tmpfs, bind, read-only
# remount), umount, pivot_root and user namespaces. Every task inside the sandbox additionally runs under bubblewrap's
# own seccomp filter, which refuses mount, new namespaces, keyrings, BPF, io_uring, ptrace and the like.
# Install on Ubuntu / Debian hosts (needs AppArmor 4, e.g. Ubuntu 24.04, for the `userns` rule); /etc/apparmor.d/ is
# loaded again at every boot:
#   sudo cp deploy/apparmor/doi-parser /etc/apparmor.d/ && sudo apparmor_parser -r -W /etc/apparmor.d/doi-parser
# Without it loaded, the parser container does not start (compose: apparmor=doi-parser); it is never run unconfined.
abi <abi/4.0>,
include <tunables/global>

profile doi-parser flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # bubblewrap: user namespace, its mounts and the switch of the root (docker-default denies all mounts). Mounts are
  # allowed only below bubblewrap's staging root /newroot (and the propagation change of / it makes first); the option
  # sets are the ones bubblewrap uses (measured on Ubuntu 24.04, e.g. "ro, nosuid, nodev, remount, bind, silent, relatime").
  userns,
  # on / only the propagation change bubblewrap makes first, as exact flag sets: a fresh filesystem over / is not
  # allowed (`options in` would also allow a plain `rw` mount of any type, Codex E5 F3)
  mount options=(rw, rslave) -> /,
  mount options=(rw, silent, rslave) -> /,
  mount options=(rw, rprivate) -> /,
  mount options=(rw, silent, rprivate) -> /,
  # bubblewrap's staging: a tmpfs on /tmp, /tmp/newroot bound onto itself, the old root made private after pivot_root
  # (measured in complain mode on Ubuntu 24.04: these were the only mounts beyond the rules below)
  mount fstype=tmpfs -> /tmp/,
  mount options in (rw, bind, rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount options=(rw, silent, rprivate) -> /oldroot/,
  mount options=(rw, rprivate) -> /oldroot/,
  mount fstype=tmpfs -> /newroot/**,
  mount fstype=devpts -> /newroot/**,
  mount fstype=mqueue -> /newroot/**,
  mount fstype=proc -> /newroot/**,
  mount options in (ro, rw, nosuid, nodev, noexec, remount, bind, rbind, silent, relatime, noatime, strictatime, nodiratime) -> /newroot/**,
  mount options in (ro, rw, nosuid, nodev, noexec, remount, bind, rbind, silent, relatime, noatime, strictatime, nodiratime) -> /newroot/,
  pivot_root,

  signal (receive) peer=unconfined,
  signal (send,receive) peer=doi-parser,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=doi-parser,
}
